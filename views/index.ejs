                    <i class="fa-solid fa-right-to-bracket"></i><span class="pill-text">Login</span>
                </a>
                <a href="/auth/register" class="nav-pill nav-pill-solid">
                    <i class="fa-solid fa-user-plus"></i><span class="pill-text">Register</span>
                </a>
            <% } else { %>
                <form action="/auth/logout" method="POST" style="display:inline;">
