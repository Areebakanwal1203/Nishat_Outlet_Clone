<script>
    document.getElementById('year').textContent = new Date().getFullYear();

    function openSidebar(){
        document.getElementById("mobileSidebar").classList.add("open");
        document.getElementById("mobileOverlay").classList.add("show");
        document.body.style.overflow = "hidden";
    }

    function closeSidebar(){
        document.getElementById("mobileSidebar").classList.remove("open");
        document.getElementById("mobileOverlay").classList.remove("show");
        document.body.style.overflow = "";
    }
</script>

<!-- Flash Toasts -->
<% if ((success && success.length > 0) || (error && error.length > 0)) { %>
<div style="position:fixed;top:18px;right:18px;z-index:9999;display:flex;flex-direction:column;gap:8px;" id="flashToast">
    <% if (success) { success.forEach(msg => { %>
        <div style="padding:12px 20px;background:#e8f5e9;color:#2e7d32;border-left:4px solid #2e7d32;border-radius:8px;font-size:14px;font-family:Arial,sans-serif;box-shadow:0 4px 16px rgba(0,0,0,0.1);">
            <i class="fa-solid fa-circle-check"></i> <%= msg %>
        </div>
    <% }) } %>
    <% if (error) { error.forEach(msg => { %>
        <div style="padding:12px 20px;background:#fce4ec;color:#c62828;border-left:4px solid #c62828;border-radius:8px;font-size:14px;font-family:Arial,sans-serif;box-shadow:0 4px 16px rgba(0,0,0,0.1);">
            <i class="fa-solid fa-circle-exclamation"></i> <%= msg %>
        </div>
    <% }) } %>
</div>
<script>setTimeout(() => { const t = document.getElementById('flashToast'); if(t){t.style.transition='0.5s';t.style.opacity='0';setTimeout(()=>t.remove(),500);} }, 4000);</script>
<% } %>

</body>
